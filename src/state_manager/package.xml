<?xml version="1.0"?>
<package format="3">
  <name>state_manager</name>
  <version>0.1.0</version>
  <description>R1 overall health, state transitions and joint-space action arbitration.</description>
  <maintainer email="ohkwon@daedong.co.kr">jimmy</maintainer>
  <license>Proprietary</license>
  <depend>rclrs</depend>
  <depend>fastdds</depend>
  <depend>std_msgs</depend>
  <depend>humanoid_controller_msg</depend>
  <depend>sensor_msgs</depend>
